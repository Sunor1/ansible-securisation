// Fichier géré par Ansible : ne pas modifier à la main
options {
        listen-on port 53 { 127.0.0.1; {{ bind_listen_address }}; };
        listen-on-v6 port 53 { none; };
        directory "/var/named";
        allow-query { localhost; {{ bind_allowed_network }}; };
        recursion yes;
        forwarders { {{ bind_forwarder }}; };
        forward only;
        dnssec-validation no;
};

zone "." IN {
        type hint;
        file "named.ca";
};

include "/etc/named.rfc1912.zones";
